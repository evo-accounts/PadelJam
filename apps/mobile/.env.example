# Mobile app environment variables (copy to .env; EXPO_PUBLIC_* are inlined at build time).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=development

# Stream Chat public API key (from the Stream dashboard). The matching secret is set
# server-side as the STREAM_API_SECRET Supabase secret — never put the secret here.
EXPO_PUBLIC_STREAM_API_KEY=
