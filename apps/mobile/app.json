{
  "expo": {
    "name": "PadelJam",
    "slug": "padel-jam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/65f82743-d9b9-4409-9ac7-64938eee6a2c"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.padeljam",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.padeljam",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withPodMinimumDeploymentTarget",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Outfit-Regular.ttf",
              "./assets/fonts/Outfit-Medium.ttf",
              "./assets/fonts/Outfit-SemiBold.ttf",
              "./assets/fonts/Outfit-Bold.ttf",
              "./assets/fonts/Outfit-ExtraBold.ttf",
              "./assets/fonts/Atelia-Regular.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Outfit",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Outfit-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Outfit-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Outfit-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Outfit-Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Outfit-ExtraBold.ttf", "weight": 800 }
                ]
              },
              {
                "fontFamily": "Atelia",
                "fontDefinitions": [{ "path": "./assets/fonts/Atelia-Regular.ttf", "weight": 400 }]
              }
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-localization",
      "expo-image",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "PadelJam adds an event to your calendar when you ask it to."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PadelJam uses your location to suggest nearby games and communities."
        }
      ],
      [
        "expo-dynamic-app-icon",
        {
          "primary": {
            "image": "./assets/app-icons/primary.png",
            "prerendered": true
          },
          "blue": {
            "image": "./assets/app-icons/blue.png",
            "prerendered": true
          },
          "dark": {
            "image": "./assets/app-icons/dark.png",
            "prerendered": true
          },
          "light": {
            "image": "./assets/app-icons/light.png",
            "prerendered": true
          },
          "mono": {
            "image": "./assets/app-icons/mono.png",
            "prerendered": true
          },
          "classic": {
            "image": "./assets/app-icons/classic.png",
            "prerendered": true
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "65f82743-d9b9-4409-9ac7-64938eee6a2c"
      }
    },
    "owner": "evo-studio"
  }
}
