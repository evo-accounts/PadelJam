# Public (client + server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
APP_ENV=development
SENTRY_DSN=

# Server only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Apple / Google OAuth (Supabase Auth external providers) — both already enabled in
# infra/supabase/config.toml, which reads these through env(). Leaving them unset is fine:
# the local stack starts either way, and values are only needed to complete a real sign-in.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Email delivery (Resend) — used by the send-roster-csv / send-blast edge functions
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Push notifications — shared secret guarding the send-push edge function (DB trigger → pg_net → edge fn)
PUSH_WEBHOOK_SECRET=

# Reserved (later specs)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=
